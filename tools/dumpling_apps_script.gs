/**
 * Abenteuerweltchen – DER FALL DER VERSCHWUNDENEN DUMPLINGS personalisieren (Google Apps Script Web-App)
 * Eigenes Skript nur für dieses Produkt (alle anderen Skripte bleiben unverändert).
 *
 *  1. Make schickt die Bestellung (Name, Geschlecht, E-Mail – auch als rohe Etsy-Angaben) an doPost.
 *  2. Das Skript erzeugt einen geheimen Zufallscode – der Name steht NIE in einer Adresse.
 *  3. Es baut die PDF (Name auf Titel, Botschaften, Ausweis, Urkunde + 6 QR-Codes mit dem Code)
 *     und legt sie in „02 Auslieferungen (automatisch)/<Bestellnr>_<Name>“ (per Link lesbar).
 *  4. Es legt einen PRIVATEN Ordner „Namensclips (privat)/<Code>“ an und liefert Make die 10 persönlichen
 *     Namens-Clips von Chefkoch Wong. Make lässt sie von ElevenLabs sprechen und legt die MP3s dort ab.
 *  5. Das Detektiv-Handy (abenteuerweltchen.github.io/mondmission-player/dumpling) ruft doGet mit dem Code auf
 *     und bekommt Name, Geschlecht und die persönlichen MP3s. Fehlt ein Clip, spielt es ohne Namens-Clip weiter.
 *  6. Aufräumen: Bestellungen älter als 13 Monate werden täglich gelöscht (Funktion einrichten einmal ausführen).
 *
 * Texte ändern: unten bei TRACKS. {N} = Name.
 */
var CONFIG = {
  TOKEN: '%%TOKEN%%',
  TEMPLATE_ID: '',
  TEMPLATE_URL: 'https://abenteuerweltchen.github.io/mondmission-player/tools/dumpling_vorlage.bin',
  TEMPLATE_KEY: '%%TEMPLATEKEY%%',
  PRODUCT_FOLDER_ID: '1NyMq0hL4Kw0scXhherekrmqO9tNo25Ki',   // 01 Produkte › Detektiv-Schatzsuche Dumplings
  PRIVATE_FOLDER_ID: '1Qvpb1BRw6_WFH8IpicB5567SoZ8YWxob',   // … › Namensclips (privat)
  OUTPUT_FOLDER_ID: '1Afrq-TwLsQ5uvulyVUBl8lFXUSvTvd07',    // 02 Auslieferungen (automatisch)
  PDF_PREFIX: 'Dumpling-Detektive_',
  TEMPLATE_NAME: 'dumpling_vorlage.pdf',
  AUDIO_MODEL: 'eleven_v4',
  VOICES: { wong: 'yYTemNXovAWXGGqLADJf' },
  DEMO_ORDER: 'DEMO-EMMA', DEMO_CODE: 'demoemma',   // feste Demo-Adresse für Werbung (immer Emma)
  KEEP_DAYS: 400,
};
// [Nr, Sprecher, Text] – Wong spricht den Namen vor jeder Botschaft
var TRACKS = [
  ["01", "wong", "Hallo {N}!"],
  ["02", "wong", "Gut gemacht, {N}!"],
  ["03", "wong", "Achtung, {N}!"],
  ["04", "wong", "Hör gut zu, {N}!"],
  ["05", "wong", "Vorsicht, {N}!"],
  ["06", "wong", "Spannend, {N}!"],
  ["07", "wong", "Fast geschafft, {N}!"],
  ["08", "wong", "Alle Aussagen liegen vor, {N}!"],
  ["09", "wong", "Leo?! Das hätte ich nie gedacht, {N}!"],
  ["10", "wong", "Danke, {N}!"]
];

// ---------------- Make → neue Bestellung ----------------
function doPost(e) {
  var p = (e && e.parameter) || {};
  return json_(bestellung_(p));
}

function bestellung_(p) {
  var t0 = Date.now(), props = PropertiesService.getScriptProperties();
  try {
    if (p.token !== CONFIG.TOKEN) return { ok: false, error: 'UNAUTHORIZED: falscher Schlüssel' };
    var input = readInput_(p);
    var order = String(p.order_id || ('TEST-' + Date.now()));
    var demo = order === CONFIG.DEMO_ORDER;
    var name = demo ? 'Emma' : cleanName_(input.name), gender = demo ? 'w' : cleanGender_(input.gender);
    // gleiche Bestellung nochmal (Nachliefern) → gleicher Code, damit die gedruckten QR-Codes gültig bleiben
    var code = demo ? CONFIG.DEMO_CODE : (props.getProperty('o_' + order) || neuerCode_());
    var r = personalizeDumpling(templateBytes_(), name, gender, code);

    var folderName = safe_(order) + '_' + safe_(r.name);
    var parent = DriveApp.getFolderById(CONFIG.OUTPUT_FOLDER_ID);
    var it = parent.getFoldersByName(folderName);
    var folder = it.hasNext() ? it.next() : parent.createFolder(folderName);
    var files = folder.getFiles();
    while (files.hasNext()) files.next().setTrashed(true);
    var pdfName = CONFIG.PDF_PREFIX + safe_(r.name) + '.pdf';
    var signed = new Array(r.bytes.length);
    for (var i = 0; i < r.bytes.length; i++) signed[i] = r.bytes[i] > 127 ? r.bytes[i] - 256 : r.bytes[i];
    var pdf = folder.createFile(Utilities.newBlob(signed, 'application/pdf', pdfName));
    var shared = true;
    try { folder.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW); } catch (e2) { shared = false; }

    // privater Ordner für die persönlichen Namens-Clips
    var priv = privatOrdner_(code, true);
    var old = priv.getFilesByType('audio/mpeg');
    while (old.hasNext()) old.next().setTrashed(true);
    var infos = priv.getFilesByName('info.json');
    while (infos.hasNext()) infos.next().setTrashed(true);
    priv.createFile('info.json', JSON.stringify({ name: r.name, g: r.gender, order: order, created: new Date().toISOString() }), 'application/json');
    props.setProperty('o_' + order, code);
    props.setProperty('k_' + code, priv.getId());

    var jobs = audioJobs_(r.name);
    return {
      ok: true, order_id: order, name: r.name, gender: r.gender, email: input.email, code: code,
      player_url: DUMPLING_PLAYER_URL + '?k=' + code,
      folder_id: folder.getId(), folder_url: folder.getUrl(), folder_shared: shared,
      file_id: pdf.getId(), file_name: pdfName,
      audio_folder_id: priv.getId(), audio_jobs: jobs, audio_count: jobs.length,
      audio_chars: jobs.reduce(function (t, j) { return t + j.body.text.length; }, 0),
      size_kb: Math.round(r.bytes.length / 1024), ms: Date.now() - t0,
    };
  } catch (err) {
    return { ok: false, error: String((err && err.message) || err), ms: Date.now() - t0 };
  }
}

function audioJobs_(name) {
  return TRACKS.map(function (tr) {
    return { key: 'n' + tr[0], file_name: 'n' + tr[0] + '.mp3', voice_id: CONFIG.VOICES[tr[1]],
             body: { text: tr[2].replace(/\{N\}/g, name), model_id: CONFIG.AUDIO_MODEL, language_code: 'de' } };
  });
}

// ---------------- Detektiv-Handy → Name + persönliche Namens-Clips ----------------
// ?k=CODE → Name/Geschlecht · ?k=CODE&b=N → Namens-Clip der Botschaft N (base64) oder null
function doGet(e) {
  var p = (e && e.parameter) || {};
  try {
    var k = String(p.k || '').toLowerCase();
    if (!/^[a-z0-9]{6,16}$/.test(k)) return json_({ ok: false, error: 'kein Code' });
    var fid = PropertiesService.getScriptProperties().getProperty('k_' + k);
    if (!fid) return json_({ ok: false, error: 'unbekannt' });
    var folder = DriveApp.getFolderById(fid);
    if (p.b === undefined) {
      var info = JSON.parse(folder.getFilesByName('info.json').next().getBlob().getDataAsString());
      return json_({ ok: true, name: info.name, g: info.g });
    }
    var n = ('0' + parseInt(p.b, 10)).slice(-2);
    var f = folder.getFilesByName('n' + n + '.mp3');
    return json_({ ok: true, a: f.hasNext() ? Utilities.base64Encode(f.next().getBlob().getBytes()) : null });
  } catch (err) {
    return json_({ ok: false, error: 'Fehler' });
  }
}

// ---------------- Einrichtung (einmal im Editor ausführen) ----------------
/** Holt die (verschlüsselte) Vorlage von GitHub, entschlüsselt sie und legt sie in den Produktordner. Ebenso bei Vorlagen-Updates. */
function vorlageHolen() {
  var enc = UrlFetchApp.fetch(CONFIG.TEMPLATE_URL + '?v=' + Date.now()).getContent();
  var plain = xorStream_(enc, CONFIG.TEMPLATE_KEY);
  var signed = new Array(plain.length);
  for (var i = 0; i < plain.length; i++) signed[i] = plain[i] > 127 ? plain[i] - 256 : plain[i];
  if (String.fromCharCode.apply(null, plain.subarray(0, 5)) !== '%PDF-') throw new Error('Entschlüsselung fehlgeschlagen');
  var folder = DriveApp.getFolderById(CONFIG.PRODUCT_FOLDER_ID);
  var old = folder.getFilesByName(CONFIG.TEMPLATE_NAME);
  while (old.hasNext()) old.next().setTrashed(true);
  var f = folder.createFile(Utilities.newBlob(signed, 'application/pdf', CONFIG.TEMPLATE_NAME));
  PropertiesService.getScriptProperties().setProperty('TEMPLATE_ID', f.getId());
  Logger.log('Vorlage gespeichert: ' + f.getId() + ' (' + plain.length + ' Bytes)');
}
/** Einmal ausführen: täglicher Aufräum-Auftrag (löscht alte Bestellungen nach KEEP_DAYS Tagen, außer der Demo). */
function einrichten() {
  ScriptApp.getProjectTriggers().forEach(function (t) { if (t.getHandlerFunction() === 'aufraeumen') ScriptApp.deleteTrigger(t); });
  ScriptApp.newTrigger('aufraeumen').timeBased().everyDays(1).atHour(4).create();
  Logger.log('Aufräumen eingerichtet');
}
function aufraeumen() {
  var props = PropertiesService.getScriptProperties(), all = props.getProperties(), limit = Date.now() - CONFIG.KEEP_DAYS * 864e5;
  Object.keys(all).forEach(function (key) {
    if (key.indexOf('k_') !== 0 || key === 'k_' + CONFIG.DEMO_CODE) return;
    try {
      var f = DriveApp.getFolderById(all[key]);
      if (f.getDateCreated().getTime() < limit) { f.setTrashed(true); props.deleteProperty(key); }
    } catch (e) { props.deleteProperty(key); }
  });
}
/** Test im Editor: baut eine Beispiel-Bestellung (Jonas) – Ergebnis im Protokoll. */
function testlauf() {
  var r = bestellung_({ token: CONFIG.TOKEN, name: 'Jonas', gender: 'Junge', order_id: 'EDITOR-TEST', email: 'test@example.com' });
  if (r.audio_jobs) r.audio_jobs = r.audio_jobs.length + ' Clips, z. B.: ' + JSON.stringify(r.audio_jobs[2]);
  Logger.log(JSON.stringify(r, null, 1));
}

// ---------------- Hilfsfunktionen ----------------
function templateBytes_() {
  var id = PropertiesService.getScriptProperties().getProperty('TEMPLATE_ID') || CONFIG.TEMPLATE_ID;
  if (!id) throw new Error('TEMPLATE: Vorlage fehlt – im Editor einmal vorlageHolen ausführen');
  return DriveApp.getFileById(id).getBlob().getBytes();
}
function privatOrdner_(code, create) {
  var parent = DriveApp.getFolderById(CONFIG.PRIVATE_FOLDER_ID), it = parent.getFoldersByName(code);
  return it.hasNext() ? it.next() : (create ? parent.createFolder(code) : null);
}
function neuerCode_() {
  var abc = 'abcdefghjkmnpqrstuvwxyz23456789', bytes = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, Utilities.getUuid() + Math.random() + Date.now()), s = '';
  for (var i = 0; i < 12; i++) s += abc.charAt((bytes[i] & 255) % abc.length);
  return s;
}
function xorStream_(bytes, keyHex) {
  var u = Uint8Array.from(bytes, function (b) { return b & 255; });
  var a = parseInt(keyHex.slice(0, 8), 16) >>> 0, b = parseInt(keyHex.slice(8, 16), 16) >>> 0,
      c = parseInt(keyHex.slice(16, 24), 16) >>> 0, d = parseInt(keyHex.slice(24, 32), 16) >>> 0;
  for (var i = 0; i < u.length; i += 4) {
    var x = Math.imul(b, 5) >>> 0; x = ((x << 7) | (x >>> 25)) >>> 0; var r = Math.imul(x, 9) >>> 0;
    var t = (b << 9) >>> 0;
    c = (c ^ a) >>> 0; d = (d ^ b) >>> 0; b = (b ^ c) >>> 0; a = (a ^ d) >>> 0; c = (c ^ t) >>> 0; d = ((d << 11) | (d >>> 21)) >>> 0;
    for (var j = 0; j < 4 && i + j < u.length; j++) u[i + j] ^= (r >>> (8 * j)) & 255;
  }
  return u;
}
function json_(o) { return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON); }
function safe_(s) {
  return String(s).normalize('NFKD').replace(/[̀-ͯ]/g, '').replace(/ß/g, 'ss')
    .replace(/[^A-Za-z0-9-]+/g, '_').replace(/^_+|_+$/g, '') || 'x';
}
function decode_(s) {
  return String(s || '').replace(/<br\s*\/?>/gi, '\n').replace(/&#(\d+);/g, function (_, d) { return String.fromCharCode(+d); })
    .replace(/&quot;/g, '"').replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>');
}
/** Liest Name, Geschlecht und E-Mail (direkt oder aus den rohen Etsy-Angaben) – wie bei den Schatzsuchen. */
function readInput_(p) {
  var name = p.name || '', gender = p.gender || '', email = p.email || '';
  var EMAIL_RE = /[A-Za-z0-9._%+\-]+@[A-Za-z0-9.\-]+\.[A-Za-z]{2,}/;
  var rawN = [], rawV = [];
  for (var k = 1; k <= 10; k++) {
    if (p['var' + k + '_name'] === undefined && p['var' + k + '_value'] === undefined) continue;
    rawN.push(p['var' + k + '_name'] || ''); rawV.push(p['var' + k + '_value'] || '');
  }
  var fields = [];
  for (var i = 0; i < rawN.length; i++) {
    var n0 = decode_(rawN[i]).trim(), v0 = decode_(rawV[i] || '').trim();
    if (!n0 && !v0) continue;
    var pairs = [], re = /(^|\n)\s*([^:\n]{2,60}?)\s*:\s*([^\n]*)/g, m;
    while ((m = re.exec(v0))) pairs.push([m[2], m[3].trim()]);
    if (pairs.length >= 2 && (rawN.length === 1 || /personali/i.test(n0))) pairs.forEach(function (pr) { fields.push(pr); });
    else fields.push([n0, v0]);
  }
  fields.forEach(function (f) {
    var n = f[0].toLowerCase(), v = f[1];
    var mMail = EMAIL_RE.exec(v);
    if (mMail) {
      if (!email) email = mMail[0];
      v = v.replace(mMail[0], '').replace(/(e-?mail(-adresse)?|adresse)\s*[:=\-]?\s*/ig, '').trim();
    }
    if (/mail/.test(n)) return;
    if (/geschlecht|junge|mädchen|maedchen|gender/.test(n)) { if (!gender) gender = v; return; }
    if (/personali|name/.test(n)) {
      if (!v) return;
      var mName = /(?:vor)?name[^:=\n]*[:=]\s*([^\n,;|]+)/i.exec(v);
      var mGen = /\b(junge|mädchen|maedchen)\b/i.exec(v);
      if (!name) name = mName ? mName[1] : (mGen ? v.replace(mGen[0], '') : v).replace(/[,;|]+/g, ' ');
      if (!gender && mGen) gender = mGen[1];
    }
  });
  return { name: String(name).replace(/\s+/g, ' ').trim(), gender: gender, email: email };
}

// ================= PDF-Personalisierung =================
/**
 * Dumpling-Schatzsuche – Personalisierung der PDF (reines JavaScript, läuft in Apps Script und lokal in Node).
 * Stempelt per PDF-Inkrement auf die Basis-Vorlage:
 *   Name + Meisterdetektiv/in (Titel, Botschaften 1–10, Ausweis, Urkunde) als Vektorschrift · 6 QR-Codes mit dem persönlichen Code
 * Benötigt die Bibliothek qrcode-generator (qrcode(...)).
 */
var DUMPLING_PLAYER_URL = 'https://abenteuerweltchen.github.io/mondmission-player/dumpling/';
var MD_WORD = { m: 'Meisterdetektiv', w: 'Meisterdetektivin' };

function cleanName_(raw) {
  var name = String(raw || '').normalize('NFC').replace(/\([^)]*\)/g, ' ').replace(/[„“"”]/g, '').replace(/\s+/g, ' ').trim();
  if (!name) throw new Error('EMPTY_NAME: Kein Name angegeben');
  if (/[@0-9]/.test(name)) throw new Error('BAD_NAME: Name sieht falsch aus: "' + name + '"');
  if (/\b(und|&|\+)\b|,|\//i.test(name)) throw new Error('BAD_NAME: Mehrere Namen? "' + name + '" – bitte prüfen');
  if (Array.from(name).length > 24) throw new Error('NAME_TOO_LONG: Name zu lang (max. 24 Zeichen): "' + name + '"');
  if (name === name.toLowerCase() || name === name.toUpperCase()) {
    name = name.toLowerCase().replace(/(^|[\s\-'’])(\p{L})/gu, function (_, sep, ch) { return sep + ch.toUpperCase(); });
  }
  return name;
}

function cleanGender_(raw) {
  var g = String(raw || '').trim().toLowerCase();
  if (['mädchen', 'maedchen', 'madchen', 'w', 'weiblich', 'girl', 'f', 'female', 'tochter'].indexOf(g) >= 0) return 'w';
  if (['junge', 'm', 'männlich', 'maennlich', 'mannlich', 'boy', 'male', 'sohn'].indexOf(g) >= 0) return 'm';
  throw new Error('BAD_GENDER: Unbekanntes Geschlecht "' + raw + '" (erwartet Junge oder Mädchen)');
}


function personalizeDumpling(tplBytes, rawName, rawGender, code) {
  var name = cleanName_(rawName), gender = cleanGender_(rawGender);
  if (!/^[a-z0-9]{6,16}$/.test(code)) throw new Error('BAD_CODE');
  var bytes = tplBytes instanceof Uint8Array ? tplBytes : Uint8Array.from(tplBytes, function (b) { return b & 255; });
  var data = readData_(bytes), sp = data.spec;
  Object.keys(data.fonts).forEach(function (fk) {
    var miss = Array.from(name).filter(function (ch) { return !data.fonts[fk].glyphs[ch]; });
    if (miss.length) throw new Error('UNSUPPORTED_CHAR: Zeichen nicht unterstützt: ' + miss.join(' '));
  });
  var ops = {};
  var add = function (page, s) { ops[page] = (ops[page] || '') + s; };
  sp.name_slots.forEach(function (sl) {
    var text = sl.text.split('{N}').join(name).split('{MD}').join(MD_WORD[gender]);
    add(sl.page, textOps_(data.fonts[sl.font], text, sl));
  });
  sp.qr.forEach(function (q) {
    add(q.page, qrOps_(DUMPLING_PLAYER_URL + '?' + (q.s === 'start' ? '' : 's=' + q.s + '&') + 'k=' + code, q));
  });

  var tail = asciiSlice_(bytes, Math.max(0, bytes.length - 2048), bytes.length);
  var prev = parseInt(/startxref\s+(\d+)\s+%%EOF\s*$/.exec(tail)[1], 10);
  var size = parseInt(/\/Size\s+(\d+)/.exec(tail.slice(tail.lastIndexOf('trailer')))[1], 10);
  var infoM = /\/Info\s+(\d+)\s+0\s+R/.exec(tail.slice(tail.lastIndexOf('trailer')));
  var objs = [], next = size;
  var qObj = next++, QObj = next++;
  objs.push([qObj, stream_('q')], [QObj, stream_('Q')]);
  data.pages.forEach(function (pg, idx) {
    var contents = pg.contents;
    if (ops[idx + 1]) {
      var o = next++;
      objs.push([o, stream_('q\n' + ops[idx + 1] + 'Q')]);
      contents = qObj + ' 0 R ' + contents + ' ' + QObj + ' 0 R ' + o + ' 0 R';
    }
    objs.push([pg.obj, pg.dict.replace('__PARENT__', data.root + ' 0 R').replace('__CONTENTS__', '[' + contents + ']')]);
  });
  objs.push([data.root, '<</Type/Pages/Kids[' + data.pages.map(function (p) { return p.obj + ' 0 R'; }).join(' ') + ']/Count ' + data.pages.length + '>>']);
  if (infoM) objs.push([parseInt(infoM[1], 10), '<</Title' + pdfText_('Der Fall der verschwundenen Dumplings – Detektiv-Schatzsuche für ' + name) + '/Producer(Abenteuerweltchen)>>']);
  var parts = ['\n'], offset = bytes.length + 1, xref = [];
  objs.forEach(function (o) {
    var txt = o[0] + ' 0 obj\n' + o[1] + '\nendobj\n';
    xref.push([o[0], offset]); parts.push(txt); offset += txt.length;
  });
  xref.sort(function (a, b) { return a[0] - b[0]; });
  var xs = 'xref\n0 1\n0000000000 65535 f \n';
  xref.forEach(function (e) { xs += e[0] + ' 1\n' + ('0000000000' + e[1]).slice(-10) + ' 00000 n \n'; });
  xs += 'trailer\n<</Size ' + next + '/Root ' + data.catalog + ' 0 R' + (infoM ? '/Info ' + infoM[1] + ' 0 R' : '') + '/Prev ' + prev + '>>\nstartxref\n' + offset + '\n%%EOF\n';
  parts.push(xs);
  var addStr = parts.join('');
  var out = new Uint8Array(bytes.length + addStr.length);
  out.set(bytes, 0);
  for (var i = 0; i < addStr.length; i++) out[bytes.length + i] = addStr.charCodeAt(i) & 255;
  return { bytes: out, name: name, gender: gender };
}

/** Text mittig, bei Bedarf kleiner (max_width). */
function textOps_(font, text, sl) {
  var width = function (size) { return layout_(font, text, size, sl.tracking).width; };
  var size = sl.size * Math.min(1, sl.max_width / width(sl.size));
  var l = layout_(font, text, size, sl.tracking), k = size / font.upem, x = sl.cx - l.width / 2, s = rgb_(sl.color, 'rg');
  l.items.forEach(function (it) { if (it.path) s += svgToPdf_(it.path, x + it.x, sl.base, k) + 'f\n'; });
  return s;
}

function rgb_(hex, op) {
  var n = parseInt(hex.slice(1), 16);
  return fmt_(((n >> 16) & 255) / 255) + ' ' + fmt_(((n >> 8) & 255) / 255) + ' ' + fmt_((n & 255) / 255) + ' ' + op + '\n';
}

function qrOps_(url, q) {
  var qr = qrcode(0, 'M'); qr.addData(url); qr.make();
  var n = qr.getModuleCount(), m = q.size / (n + 4), s = '1 1 1 rg\n' + fmt_(q.x) + ' ' + fmt_(q.y) + ' ' + fmt_(q.size) + ' ' + fmt_(q.size) + ' re f\n0.11 0.13 0.18 rg\n';
  for (var r = 0; r < n; r++) {
    var c = 0;
    while (c < n) {
      if (!qr.isDark(r, c)) { c++; continue; }
      var c0 = c; while (c < n && qr.isDark(r, c)) c++;
      s += fmt_(q.x + (c0 + 2) * m) + ' ' + fmt_(q.y + q.size - (r + 3) * m) + ' ' + fmt_((c - c0) * m + 0.02) + ' ' + fmt_(m + 0.02) + ' re\n';
    }
  }
  return s + 'f\n';
}

function readData_(bytes) {
  var start = indexOf_(bytes, '%%AWDATA-BEGIN%%'), end = indexOf_(bytes, '%%AWDATA-END%%', start);
  if (start < 0 || end < 0) throw new Error('TEMPLATE: Vorlage ohne Layoutdaten (falsche Datei?)');
  return JSON.parse(asciiSlice_(bytes, start + 16, end));
}

function indexOf_(bytes, ascii, from) {
  var first = ascii.charCodeAt(0), n = ascii.length;
  outer: for (var i = from || 0; i <= bytes.length - n; i++) {
    if (bytes[i] !== first) continue;
    for (var j = 1; j < n; j++) if (bytes[i + j] !== ascii.charCodeAt(j)) continue outer;
    return i;
  }
  return -1;
}

function asciiSlice_(bytes, a, b) {
  var s = '', CH = 8192;
  for (var i = a; i < b; i += CH) s += String.fromCharCode.apply(null, bytes.subarray(i, Math.min(b, i + CH)));
  return s;
}

function layout_(font, text, size, tracking) {
  var s = size / font.upem, items = [], x = 0;
  Array.from(text).forEach(function (ch) {
    var gl = font.glyphs[ch];
    items.push({ x: x, path: gl[1] });
    x += gl[0] * s + tracking * size;
  });
  return { items: items, width: x - tracking * size };
